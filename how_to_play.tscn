[node name="Title" type="Label" parent="."]
layout_mode = 0
offset_left = 0.0
offset_top = 30.0
offset_right = 1280.0
offset_bottom = 110.0
theme_override_font_sizes/font_size = 60
text = "HOW TO PLAY"
horizontal_alignment = 1

[node name="Text" type="Label" parent="."]
layout_mode = 0
offset_left = 120.0
offset_top = 140.0
offset_right = 1160.0
offset_bottom = 590.0
theme_override_font_sizes/font_size = 24
text = "PLAYER 1:   A / D move     W jump     F shoot     R steal     S spin
PLAYER 2:   LEFT / RIGHT move     UP jump     ENTER shoot     /  steal     DOWN spin

SHOOT:  hold shoot (even while running or jumping), let go in the green part
3 POINTS:  shoot from far away
STEAL:  press steal right next to the player with the ball
BLOCK:  jump in front of a shooter. If you block it, they fall down!
SPIN:  press spin while dribbling to go right through your defender
ANKLES:  if you try to steal during a spin, YOU fall down for 1 second

First to 11 wins!"

[node name="BackButton" type="Button" parent="."]
